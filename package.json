{
  "name": "omf-music-distribution",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "verify:webhook": "node scripts/verify-webhook-secret.mjs",
    "verify:release-db": "node scripts/verify-release-in-db.mjs",
    "db:types": "supabase gen types typescript --linked > types/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep \"@smoke\"",
    "test:e2e:regression": "playwright test --grep \"@regression\"",
    "test:e2e:full-submit": "playwright test --grep \"@full-submit\"",
    "test:e2e:pre-release": "playwright test --grep \"@smoke|@full-submit\"",
    "test:gate": "npm run check && npm run test && npm run test:e2e:pre-release",
    "deploy:preview": "npm run test:gate && npx vercel",
    "deploy:prod": "npm run test:gate && npx vercel --prod",
    "test:all": "npm run check && npm run test && npm run build",
    "clean": "rm -rf .next node_modules/.cache tsconfig.tsbuildinfo",
    "supabase:empty-storage": "node scripts/empty-storage-buckets.mjs",
    "supabase:delete-auth-users": "node scripts/delete-all-auth-users.mjs",
    "supabase:wipe-releases": "node scripts/wipe-all-releases.mjs",
    "depwire:whatif": "depwire whatif",
    "depwire:security": "depwire security",
    "depwire:viz": "depwire viz"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@vercel/blob": "^2.8.1",
    "border-beam": "^1.4.1",
    "bot-avatars": "0.2.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "img-fx": "^0.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "thinking-orbs": "^0.3.2",
    "three": "^0.186.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "depwire-cli": "^1.0.8",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "playwright": "^1.59.1",
    "postcss": "^8.5.8",
    "supabase": "^2.84.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
